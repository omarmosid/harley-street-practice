---
/**
 * /membership - private GP membership page.
 * Source: content-cache/pages/membership-1.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import Icon from '../components/ui/Icon.astro';
import { BOOKING_URL, PRACTICE, SITE_NAME, SITE_URL } from '../consts';

const title = 'Private GP membership - London Harley Street Practice';
const description =
  'Join London Harley Street Practice for discreet, personalised, priority healthcare with same-day access, private GP consultations, diagnostics, and family membership options.';

const benefits = [
  'Prompt appointments and reduced waiting times for member care.',
  'Personalised plans shaped around your health needs and preferences.',
  'Private GP consultations, diagnostics, referrals, and ongoing support under one roof.',
  'Wellness programmes and health screenings to help manage risk proactively.',
  'Confidential, compassionate care from a calm Harley Street setting.',
  'A multidisciplinary team using evidence-based assessment and treatment.',
];

const plans = [
  {
    name: 'Starter',
    price: '£120 annual fee',
    summary: 'Reliable access for patients who want flexibility without bundled appointments.',
    features: ['Standard pay-as-you-go clinic fees', 'Seasonal discounts', 'No prescription charges'],
  },
  {
    name: 'Priority',
    price: '£95 per person / month',
    summary: 'A year-round membership for patients who value structured access and predictable support.',
    features: [
      'Minimum 6 months',
      '12 GP consultations per year including telephone or video consultations',
      'Priority access',
      'No sign-up fee',
      'No prescription charges',
      '5% discount for health checks, blood tests, and ultrasound scans at the clinic',
      'Discounted family bundle available',
    ],
  },
  {
    name: 'Apex',
    price: '£140 per person / month',
    summary: 'The most comprehensive membership for patients who want premium, continuous care.',
    features: [
      'Minimum 12 months',
      'Unlimited GP consultations including telephone or video consultations',
      'Priority access',
      'Free annual consultation with our Musculoskeletal therapist',
      'Free annual consultation with our Psychotherapist',
      'Free annual ear hygiene treatment',
      'Free annual Well Man or Well Woman Health Check',
      '10% discount for annual health checks and ultrasound scans at the clinic',
      '10% discount for laboratory tests and home visits, subject to normal restrictions',
    ],
  },
];

const steps = [
  {
    title: 'Apply',
    copy: 'Contact the practice to begin your membership application. We will contact you within 24 to 48 hours.',
  },
  {
    title: 'Review',
    copy: 'Our team will answer your questions and send the relevant health questionnaire and service agreement forms.',
  },
  {
    title: 'Clinical approval',
    copy: 'The clinical team reviews your application and, once approved, arranges an optional welcome phone or video call with a doctor.',
  },
  {
    title: 'Start using benefits',
    copy: 'Once the process is complete, you can begin using the benefits of your chosen membership tier.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Private GP membership',
  provider: { '@type': 'MedicalBusiness', name: SITE_NAME, url: SITE_URL },
  url: `${SITE_URL}/membership`,
  description,
  areaServed: 'London',
};
---

<BaseLayout title={title} description={description} canonical={`${SITE_URL}/membership`} jsonLd={jsonLd}>
  <section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-10 md:mb-14">
        <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Membership</p>
      </div>

      <h1
        class="font-display tracking-[-0.035em] leading-[0.96] text-text-strong max-w-[12ch]"
        style="font-size: clamp(2.5rem, 7vw, 6.5rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;"
        data-reveal
      >
        Care that knows you<span class="text-accent-400">.</span>
      </h1>

      <p
        class="mt-8 md:mt-10 max-w-[62ch] text-ink-700"
        style="font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.25rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 280ms;"
        data-reveal
      >
        Our membership is designed for patients who want priority access, longer-term continuity, and discreet, personalised private GP care from a trusted Harley Street team.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-5" data-reveal style="--reveal-delay: 380ms;">
        <a
          href={PRACTICE.email.href}
          class="group inline-flex items-center gap-3 bg-accent-400 text-accent-900 px-7 py-4 rounded-[2px] text-[14px] font-medium tracking-[0.02em] uppercase transition-colors duration-300 hover:bg-accent-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-4 focus-visible:ring-offset-bg"
        >
          <span>Enquire about membership</span>
          <Icon name="arrow-up-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>

        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="group inline-flex items-baseline gap-2 text-text-strong text-[15px] tracking-tight transition-colors duration-200 hover:text-accent-600">
          <span class="text-text-meta">Or book a consultation</span>
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16">
        <aside class="md:col-span-4 mb-10 md:mb-0">
          <div class="flex md:block items-baseline gap-4">
            <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Why join</p>
          </div>
        </aside>

        <div class="md:col-span-8 lg:col-span-7">
          <p class="dropcap text-ink-700" data-reveal style="--reveal-delay: 160ms; font-size: clamp(1.25rem, 1vw + 1rem, 1.65rem); line-height: 1.55; text-wrap: pretty;">
            Membership gives you a more continuous relationship with the practice: quicker access when you need help, structured support for prevention, and a team that understands your priorities.
          </p>

          <div class="mt-12 grid gap-px bg-border-soft border border-border-soft md:grid-cols-2">
            {benefits.map((benefit, i) => (
              <article class="bg-bg p-7 md:p-8" data-reveal style={`--reveal-delay: ${220 + i * 70}ms;`}>
                <p class="text-text-strong" style="font-size: 16px; line-height: 1.6; text-wrap: pretty;">{benefit}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-12 md:mb-16">
        <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Plans</p>
      </div>

      <div class="grid gap-px bg-border-soft border border-border-soft lg:grid-cols-3">
        {plans.map((plan, i) => (
          <article class="bg-bg p-7 md:p-9 flex flex-col" data-reveal style={`--reveal-delay: ${160 + i * 90}ms;`}>
            <h2 class="font-display text-text-strong tracking-[-0.02em] leading-[1.05]" style="font-size: clamp(2rem, 2vw + 1rem, 3rem); font-weight: 340; font-variation-settings: 'opsz' 120, 'SOFT' 40;">{plan.name}</h2>
            <p class="mt-4 font-mono text-accent-600" style="font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;">{plan.price}</p>
            <p class="mt-6 text-text-muted" style="font-size: 15px; line-height: 1.65; text-wrap: pretty;">{plan.summary}</p>
            <ul class="mt-8 space-y-3 text-[14px] leading-[1.55] text-text-muted">
              {plan.features.map((feature) => (
                <li class="flex gap-3">
                  <Icon name="check" size={15} class="mt-1 shrink-0 text-accent-600" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="mt-6 max-w-[74ch] text-text-meta text-[13px] leading-[1.65]" data-reveal style="--reveal-delay: 480ms;">
        Family bundles are available for 2 adults and 2 children aged 0-16 years. Extra child rates apply. Memberships are limited and subject to availability. The scheme is not linked to, and does not replace, the NHS.
      </p>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16 items-start">
        <aside class="md:col-span-4 mb-10 md:mb-0">
          <div class="flex md:block items-baseline gap-4">
            <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Application</p>
          </div>
        </aside>

        <div class="md:col-span-8 lg:col-span-7">
          <h2 class="font-display text-text-strong tracking-[-0.025em] leading-[1.02] max-w-[16ch]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance; --reveal-delay: 160ms;" data-reveal>Start with a conversation.</h2>

          <ol class="mt-12 border-y border-border-soft divide-y divide-border-soft">
            {steps.map((step, i) => (
              <li class="grid gap-5 md:grid-cols-12 py-7 md:py-8" data-reveal style={`--reveal-delay: ${220 + i * 80}ms;`}>
                <span class="md:col-span-2 font-mono text-text-meta" style="font-size: 12px; letter-spacing: 0.12em;">STEP {String(i + 1).padStart(2, '0')}</span>
                <div class="md:col-span-10">
                  <h3 class="font-display text-text-strong tracking-[-0.015em]" style="font-size: 1.6rem; font-weight: 360; font-variation-settings: 'opsz' 80, 'SOFT' 40;">{step.title}</h3>
                  <p class="mt-3 text-text-muted" style="font-size: 15px; line-height: 1.65;">{step.copy}</p>
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-5" data-reveal style="--reveal-delay: 560ms;">
            <a href={PRACTICE.email.href} class="group inline-flex items-center gap-3 bg-accent-400 text-accent-900 px-7 py-4 rounded-[2px] text-[14px] font-medium tracking-[0.02em] uppercase transition-colors duration-300 hover:bg-accent-100">
              <span>Email the practice</span>
              <Icon name="arrow-up-right" size={16} />
            </a>
            <a href={PRACTICE.phone.href} class="group inline-flex items-baseline gap-2 text-text-strong text-[15px] hover:text-accent-600 transition-colors">
              <span class="text-text-meta">Or call</span>
              <span class="font-medium underline decoration-1 underline-offset-[6px] decoration-ink-300 group-hover:decoration-accent-400">{PRACTICE.phone.display}</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <BookingBand />
</BaseLayout>
