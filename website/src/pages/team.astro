---
/**
 * /team — editorial roster of clinical and practice staff.
 *
 * Source: content-cache/pages/team.md. Credentials, portraits, and bios are
 * preserved from cached source content.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE_NAME, SITE_URL } from '../consts';

const entries = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const people = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const title = 'Our team — London Harley Street Practice';
const description =
  'Meet the doctors, therapist, chiropractor, and practice team behind London Harley Street Practice.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'London Harley Street Practice team',
  url: `${SITE_URL}/team`,
  itemListElement: entries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': entry.data.role.includes('General Practitioner') ? 'Physician' : 'Person',
      name: entry.data.name,
      jobTitle: entry.data.role,
      worksFor: { '@type': 'MedicalBusiness', name: SITE_NAME, url: SITE_URL },
    },
  })),
};
---

<BaseLayout title={title} description={description} canonical={`${SITE_URL}/team`} jsonLd={jsonLd}>
  <!-- Hero. -->
  <section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-10 md:mb-14">
        <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Team</p>
      </div>

      <h1
        class="font-display tracking-[-0.035em] leading-[0.96] text-text-strong"
        style="font-size: clamp(2.5rem, 7vw, 6.5rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;"
        data-reveal
      >
        The people behind<br />the practice<span class="text-accent-400">.</span>
      </h1>

      <p
        class="mt-8 md:mt-10 max-w-[58ch] text-ink-700"
        style="font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.25rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 280ms;"
        data-reveal
      >
        Experienced doctors, musculoskeletal and psychological specialists, and a front-of-house team who keep the clinic calm, coordinated, and personal.
      </p>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <!-- Roster. -->
  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <ol role="list">
        {people.map(({ entry, Content }, i) => (
          <li data-reveal style={`--reveal-delay: ${120 + i * 60}ms;`}>
            <details class="team-row group border-t border-border-soft last:border-b last:border-b-border-soft py-8 md:py-10">
              <summary class="grid grid-cols-12 gap-4 md:gap-8 cursor-pointer list-none items-start md:items-center">
                <span class="col-span-12 md:col-span-2 block">
                  {entry.data.portrait && (
                    <span class="block relative aspect-[4/5] overflow-hidden bg-bg-soft border border-border-soft">
                      <Image
                        src={entry.data.portrait}
                        alt={entry.data.portraitAlt ?? entry.data.name}
                        class="h-full w-full object-cover grayscale-[15%] transition-transform duration-700 group-hover:scale-[1.025]"
                        loading={i < 3 ? 'eager' : 'lazy'}
                        widths={[240, 360, 520]}
                        sizes="(min-width: 768px) 16vw, 80vw"
                      />
                    </span>
                  )}
                </span>

                <span class="col-span-12 md:col-span-3 pt-2 md:pt-0">
                  <span
                    class="block font-display text-text-strong tracking-[-0.025em] leading-[1.02] transition-colors duration-300 group-open:text-accent-600 group-hover:text-accent-600"
                    style="font-size: clamp(1.875rem, 2vw + 0.875rem, 3rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40;"
                  >{entry.data.name}</span>
                  <span class="mt-3 block eyebrow">{entry.data.role}</span>
                </span>

                <span class="col-span-10 col-start-3 md:col-span-2 md:col-start-auto font-mono text-text-meta pt-1 md:pt-0" style="font-size: 11px; line-height: 1.7; letter-spacing: 0.1em;">
                  {entry.data.credentials.length > 0 ? entry.data.credentials.join(' · ') : entry.data.specialties.slice(0, 2).join(' · ')}
                </span>

                <span class="hidden md:block md:col-span-3 text-text-muted" style="font-size: 14px; line-height: 1.55;">
                  {entry.data.summary}
                </span>

                <span class="col-span-1 justify-self-end text-text-meta transition-colors duration-300 group-open:text-accent-600 group-hover:text-accent-600 pt-2" aria-hidden="true">
                  <svg class="team-plus" width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M9 3V15M3 9H15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>

              <div class="md:grid md:grid-cols-12 md:gap-8 mt-7 md:mt-10">
                <div class="md:col-span-3 md:col-start-4">
                  <p class="md:hidden text-text-muted mb-6" style="font-size: 14px; line-height: 1.55;">{entry.data.summary}</p>
                  {entry.data.specialties.length > 0 && (
                    <ul role="list" class="flex flex-wrap gap-2">
                      {entry.data.specialties.map((specialty) => (
                        <li class="border border-border-soft px-3 py-1.5 font-mono text-text-meta" style="font-size: 10px; letter-spacing: 0.1em;">
                          {specialty.toUpperCase()}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <div class="team-prose md:col-span-5 mt-7 md:mt-0">
                  <Content />
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <!-- Practice link. -->
  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <a href="/about" class="group block border-t border-b border-border-soft py-8 md:py-10">
        <div class="grid grid-cols-12 gap-4 md:gap-8 items-baseline">
          <span class="col-span-2 md:col-span-1 font-mono text-text-meta" style="font-size: 12px; letter-spacing: 0.08em;">NEXT</span>
          <span
            class="col-span-9 md:col-span-6 font-display text-text-strong tracking-[-0.025em] leading-[1.02] transition-colors duration-300 group-hover:text-accent-600"
            style="font-size: clamp(2rem, 3.5vw + 1rem, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40;"
          >About the practice</span>
          <span class="hidden md:block md:col-span-4 text-text-muted" style="font-size: 15px; line-height: 1.55;">
            How the clinic works, what to expect, and how we coordinate diagnostics, referrals, and accessibility needs.
          </span>
          <span class="col-span-1 justify-self-end text-text-meta transition-all duration-300 group-hover:text-accent-600 group-hover:translate-x-1 group-hover:-translate-y-0.5">
            <Icon name="arrow-up-right" size={22} />
          </span>
        </div>
      </a>
    </Container>
  </section>

  <BookingBand />
</BaseLayout>

<style>
  .team-row summary::-webkit-details-marker { display: none; }
  .team-row[open] .team-plus path:first-child { display: none; }

  .team-prose :global(p) {
    color: var(--ink-700);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 1.25em;
    text-wrap: pretty;
  }
  .team-prose :global(p:last-child) { margin-bottom: 0; }
</style>
