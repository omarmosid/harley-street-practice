---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import Icon from '../components/ui/Icon.astro';
import { OPERATOR, SITE_NAME, SITE_URL } from '../consts';
import { breadcrumbSchema, physicianSchema } from '../lib/jsonld';

const entries = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const lead = entries.find((entry) => entry.id === 'ahmed-bachelani') ?? entries[0];

function has(entry, terms: string[]) {
  const source = `${entry.data.name} ${entry.data.role} ${entry.data.specialties.join(' ')}`.toLowerCase();
  return terms.some((term) => source.includes(term.toLowerCase()));
}

const groups = [
  {
    label: 'Doctors and GP care',
    people: entries.filter((entry) => has(entry, ['General Practitioner', 'Medical Director', 'Private GP care'])),
  },
  {
    label: 'Musculoskeletal care',
    people: entries.filter((entry) => has(entry, ['Musculoskeletal', 'Chiropractor', 'Chiropractic', 'Sports'])),
  },
  {
    label: 'Counselling and psychotherapy',
    people: entries.filter((entry) => has(entry, ['Counselling', 'Psychotherapy', 'Psychotherapist', 'Therapist'])),
  },
];
const groupedIds = new Set(groups.flatMap((group) => group.people.map((entry) => entry.id)));
const remaining = entries.filter((entry) => !groupedIds.has(entry.id));
if (remaining.length > 0) groups.push({ label: 'Clinic team', people: remaining });

const title = 'Our team | Harley Street doctors and clinicians | London Health Check';
const description = 'Meet the doctors, clinicians and practice team supporting London Health Check appointments at 66 Harley Street.';
const teamItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'London Health Check clinical team',
  url: `${SITE_URL}/team`,
  itemListElement: entries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': entry.data.role.includes('General Practitioner') ? 'Physician' : 'Person',
      name: entry.data.name,
      jobTitle: entry.data.role,
      description: entry.data.summary,
      worksFor: { '@type': 'MedicalOrganization', name: OPERATOR.name, url: OPERATOR.url },
    },
  })),
};
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Team', href: '/team' },
  ]),
  teamItemList,
  ...entries
    .filter((entry) => entry.data.role.includes('General Practitioner'))
    .map((entry) => physicianSchema({
      name: entry.data.name,
      jobTitle: entry.data.role,
      qualifications: entry.data.credentials.join(', '),
      description: entry.data.summary,
      url: `${SITE_URL}/team`,
    })),
];
---

<BaseLayout title={title} description={description} canonical={`${SITE_URL}/team`} jsonLd={jsonLd}>
  <section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow" data-reveal>Our team</p>
          <h1 class="mt-8 font-display tracking-[-0.04em] leading-[0.94] text-text-strong max-w-[12ch]" style="font-size: clamp(2.5rem, 7vw, 6.75rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;" data-reveal>
            Harley Street doctors and clinicians<span class="text-accent-400">.</span>
          </h1>
          <p class="mt-8 md:mt-10 max-w-[64ch] text-ink-700" style="font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.25rem); line-height: 1.6; text-wrap: pretty; --reveal-delay: 260ms;" data-reveal>
            Your health check is supported by doctors, clinicians and a coordinated practice team at 66 Harley Street.
          </p>
        </div>
        {lead && (
          <aside class="lg:col-span-4 border border-border-soft bg-bg-soft p-7 md:p-9" data-reveal style="--reveal-delay: 300ms;">
            <p class="eyebrow">Medical Director</p>
            <p class="mt-7 font-display text-text-strong tracking-[-0.02em] leading-[1.05]" style="font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 340; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{lead.data.name}</p>
            <p class="mt-4 text-text-muted text-[15px] leading-[1.7]">{lead.data.summary}</p>
          </aside>
        )}
      </div>
      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  {groups.map((group) => group.people.length > 0 && (
    <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
      <Container class="max-w-[var(--container-page)]">
        <div class="mb-12 md:mb-16">
          <p class="eyebrow" data-reveal>{group.label}</p>
        </div>
        <div class="grid gap-px bg-border-soft border border-border-soft md:grid-cols-2 lg:grid-cols-3">
          {group.people.map((entry, i) => (
            <article class="bg-bg p-6 md:p-8" data-reveal style={`--reveal-delay: ${120 + i * 60}ms;`}>
              {entry.data.portrait && (
                <div class="relative aspect-[4/5] overflow-hidden border border-border-soft bg-bg-soft">
                  <Image
                    src={entry.data.portrait}
                    alt={entry.data.portraitAlt ?? entry.data.name}
                    class="h-full w-full object-cover grayscale-[10%] transition-transform duration-700 hover:scale-[1.025]"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    widths={[320, 480, 640, 800]}
                    sizes="(min-width: 1024px) 28vw, (min-width: 768px) 42vw, 100vw"
                  />
                </div>
              )}
              <h2 class="mt-7 font-display text-text-strong tracking-[-0.02em] leading-[1.08]" style="font-size: clamp(1.55rem, 2vw, 2.2rem); font-weight: 360; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{entry.data.name}</h2>
              <p class="mt-3 font-mono text-text-meta text-[11px] uppercase tracking-[0.12em] leading-[1.6]">{entry.data.role}</p>
              {entry.data.credentials.length > 0 && (
                <p class="mt-4 text-text-strong text-[13px] leading-[1.6]">{entry.data.credentials.join(' · ')}</p>
              )}
              <p class="mt-5 text-text-muted text-[15px] leading-[1.7]">{entry.data.summary}</p>
              {entry.data.specialties.length > 0 && (
                <ul role="list" class="mt-6 flex flex-wrap gap-2">
                  {entry.data.specialties.slice(0, 3).map((specialty) => (
                    <li class="border border-border-soft px-3 py-1.5 font-mono text-text-meta" style="font-size: 10px; letter-spacing: 0.1em;">{specialty.toUpperCase()}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </Container>
    </section>
  ))}

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <a href="/about" class="group block border-t border-b border-border-soft py-8 md:py-10">
        <div class="grid grid-cols-12 gap-4 md:gap-8 items-baseline">
          <span class="col-span-2 md:col-span-1 font-mono text-text-meta" style="font-size: 12px; letter-spacing: 0.08em;">NEXT</span>
          <span class="col-span-9 md:col-span-6 font-display text-text-strong tracking-[-0.025em] leading-[1.02] transition-colors duration-300 group-hover:text-accent-600" style="font-size: clamp(2rem, 3.5vw + 1rem, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40;">About the clinic</span>
          <span class="hidden md:block md:col-span-4 text-text-muted" style="font-size: 15px; line-height: 1.55;">How private health check appointments work at 66 Harley Street.</span>
          <span class="col-span-1 justify-self-end text-text-meta transition-all duration-300 group-hover:text-accent-600 group-hover:translate-x-1 group-hover:-translate-y-0.5"><Icon name="arrow-up-right" size={22} /></span>
        </div>
      </a>
    </Container>
  </section>

  <BookingBand />
</BaseLayout>
