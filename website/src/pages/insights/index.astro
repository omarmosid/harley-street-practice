---
/**
 * /insights - clinical insights and practice blog article index.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import BookingBand from '../../components/sections/BookingBand.astro';
import Icon from '../../components/ui/Icon.astro';
import insightsHero from '../../content/insights/hero.jpg';
import { SITE_NAME, SITE_URL } from '../../consts';

const articleSlug = (id: string) => id.replace(/\/index$/, '');

const articles = (await getCollection('insights'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = 'Health Insights & Advice | London Harley Street Practice';
const description =
  'Clinical insights, health advice, and practice blog articles from London Harley Street Practice on private GP care, health checks, mental wellbeing, travel medicine, and prevention.';

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Clinical insights',
  url: `${SITE_URL}/insights`,
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
  description,
  hasPart: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.data.title,
    url: `${SITE_URL}/insights/${articleSlug(article.id)}`,
    datePublished: article.data.pubDate.toISOString(),
    author: {
      '@type': 'Person',
      name: article.data.author ?? SITE_NAME,
    },
  })),
};
---

<BaseLayout title={title} description={description} canonical={`${SITE_URL}/insights`} jsonLd={jsonLd}>
  <section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="flex items-baseline gap-4 mb-10 md:mb-14">
        <span class="font-mono text-text-meta block" style="font-size: 11px; letter-spacing: 0.16em;" data-reveal>00 / {String(articles.length).padStart(2, '0')}</span>
        <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Insights</p>
      </div>

      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-end">
        <div class="lg:col-span-7">
          <h1
            class="font-display tracking-[-0.035em] leading-[0.96] text-text-strong max-w-[12ch]"
            style="font-size: clamp(2.5rem, 7vw, 6.5rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;"
            data-reveal
          >
            Clinical insights<span class="text-accent-400">.</span>
          </h1>

          <p
            class="mt-8 md:mt-10 max-w-[62ch] text-ink-700"
            style="font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.25rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 280ms;"
            data-reveal
          >
            Read our latest clinical insights, health advice, and practice blog articles from the London Harley Street Practice team.
          </p>
        </div>

        <figure class="lg:col-span-5" data-reveal style="--reveal-delay: 260ms;">
          <div class="relative aspect-[4/5] overflow-hidden border border-border-soft bg-bg-soft">
            <Image
              src={insightsHero}
              alt="Calm natural landscape representing health insights"
              class="h-full w-full object-cover grayscale-[12%]"
              loading="eager"
              widths={[420, 640, 840]}
              sizes="(min-width: 1024px) 34vw, 100vw"
            />
          </div>
          <figcaption class="mt-3 font-mono text-text-meta" style="font-size: 10px; letter-spacing: 0.12em;">HEALTH ADVICE · PRACTICE BLOG</figcaption>
        </figure>
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <ol role="list" class="grid gap-px bg-border-soft border border-border-soft md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article, i) => (
          <li class="bg-bg" data-reveal style={`--reveal-delay: ${120 + i * 60}ms;`}>
            <a
              href={`/insights/${articleSlug(article.id)}`}
              class="group flex h-full flex-col p-5 md:p-6 lg:p-7"
            >
              {article.data.heroImage && (
                <span class="block aspect-[16/10] overflow-hidden border border-border-soft bg-bg-soft">
                  <Image
                    src={article.data.heroImage}
                    alt={article.data.heroImageAlt ?? article.data.title}
                    class="h-full w-full object-cover grayscale-[12%] transition-transform duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    widths={[360, 520, 720, 920]}
                    sizes="(min-width: 1024px) 28vw, (min-width: 768px) 45vw, 100vw"
                  />
                </span>
              )}

              <div class="mt-7 flex flex-1 flex-col">
                <p class="font-mono text-text-meta" style="font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;">
                  {String(i + 1).padStart(2, '0')} · {formatDate(article.data.pubDate)} · {article.data.author ?? SITE_NAME}
                </p>
                <h2 class="mt-6 font-display text-text-strong tracking-[-0.02em] leading-[1.05] transition-colors duration-300 group-hover:text-accent-600" style="font-size: clamp(1.75rem, 2.5vw, 2.6rem); font-weight: 350; font-variation-settings: 'opsz' 120, 'SOFT' 40; text-wrap: balance;">
                  {article.data.title}
                </h2>
                <p class="mt-5 text-text-muted" style="font-size: 14px; line-height: 1.6; text-wrap: pretty;">
                  {article.data.lede}
                </p>
                <span class="mt-8 inline-flex items-center gap-2 text-text-strong text-[13px] font-medium uppercase tracking-[0.06em] group-hover:text-accent-600 transition-colors">
                  Read more
                  <Icon name="arrow-up-right" size={14} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <BookingBand />
</BaseLayout>
