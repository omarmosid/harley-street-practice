---
/**
 * /appointments - booking guidance page.
 * Source: content-cache/pages/appointments.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import Icon from '../components/ui/Icon.astro';
import { BOOKING_URL, PRACTICE, SITE_NAME, SITE_URL } from '../consts';

const title = 'Appointments - London Harley Street Practice';
const description =
  'Book private GP appointments, online consultations, blood tests, and medical services at London Harley Street Practice on Harley Street.';

const steps = [
  {
    title: 'Choose your appointment',
    copy: 'Use our online booking system to select the appointment or service you need. Scroll through the options to find the most appropriate route.',
  },
  {
    title: 'Select a time',
    copy: 'Choose a date and time that works for you. Many appointment types are available on the same day.',
  },
  {
    title: 'Add your details',
    copy: 'Complete the booking form with your full details. Certain services may require payment in full or a deposit at the point of booking.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Appointments',
  url: `${SITE_URL}/appointments`,
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
  description,
};
---

<BaseLayout title={title} description={description} canonical={`${SITE_URL}/appointments`} jsonLd={jsonLd}>
  <section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-10 md:mb-14">
        <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Appointments</p>
      </div>

      <h1 class="font-display tracking-[-0.035em] leading-[0.96] text-text-strong max-w-[12ch]" style="font-size: clamp(2.5rem, 7vw, 6.5rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;" data-reveal>
        Book without the wait<span class="text-accent-400">.</span>
      </h1>

      <p class="mt-8 md:mt-10 max-w-[58ch] text-ink-700" style="font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.25rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 280ms;" data-reveal>
        Book online or call the practice to see an experienced doctor at your convenience, without the queues associated with walk-in clinics.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-5" data-reveal style="--reveal-delay: 380ms;">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 bg-accent-400 text-accent-900 px-7 py-4 rounded-[2px] text-[14px] font-medium tracking-[0.02em] uppercase transition-colors duration-300 hover:bg-accent-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-4 focus-visible:ring-offset-bg">
          <span>Open online booking</span>
          <Icon name="arrow-up-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a href={PRACTICE.phone.href} class="group inline-flex items-baseline gap-2 text-text-strong text-[15px] tracking-tight transition-colors duration-200 hover:text-accent-600">
          <span class="text-text-meta">Or call</span>
          <span class="font-medium underline decoration-1 underline-offset-[6px] decoration-ink-300 group-hover:decoration-accent-400">{PRACTICE.phone.display}</span>
        </a>
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16 items-start">
        <aside class="md:col-span-4 mb-10 md:mb-0">
          <div class="flex md:block items-baseline gap-4">
            <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>How it works</p>
          </div>
        </aside>

        <div class="md:col-span-8 lg:col-span-7">
          <ol class="border-y border-border-soft divide-y divide-border-soft">
            {steps.map((step, i) => (
              <li class="grid gap-5 md:grid-cols-12 py-7 md:py-9" data-reveal style={`--reveal-delay: ${160 + i * 90}ms;`}>
                <span class="md:col-span-2 font-mono text-text-meta" style="font-size: 12px; letter-spacing: 0.12em;">STEP {String(i + 1).padStart(2, '0')}</span>
                <div class="md:col-span-10">
                  <h2 class="font-display text-text-strong tracking-[-0.015em]" style="font-size: clamp(1.75rem, 2vw + 0.75rem, 2.5rem); font-weight: 360; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{step.title}</h2>
                  <p class="mt-4 text-text-muted" style="font-size: 15px; line-height: 1.65; text-wrap: pretty;">{step.copy}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16 items-start">
        <aside class="md:col-span-4 mb-10 md:mb-0">
          <div class="flex md:block items-baseline gap-4">
            <p class="eyebrow" style="--reveal-delay: 80ms;" data-reveal>Before you book</p>
          </div>
        </aside>

        <div class="md:col-span-8 lg:col-span-7" data-reveal style="--reveal-delay: 180ms;">
          <h2 class="font-display text-text-strong tracking-[-0.025em] leading-[1.02] max-w-[16ch]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;">If you are unsure, call first.</h2>
          <p class="mt-8 max-w-[58ch] text-ink-700" style="font-size: clamp(1.0625rem, 0.4vw + 0.95rem, 1.1875rem); line-height: 1.65; text-wrap: pretty;">
            Some services require preparation, documentation, or a specific appointment type. Our team can guide you to the right booking and help confirm what to bring.
          </p>

          <div class="mt-10 grid gap-6 md:grid-cols-3 border-t border-border-soft pt-8">
            <div>
              <p class="eyebrow mb-3">Telephone</p>
              <a href={PRACTICE.phone.href} class="text-text-strong text-[15px] leading-[1.55] hover:text-accent-600 transition-colors">{PRACTICE.phone.display}</a>
            </div>
            <div>
              <p class="eyebrow mb-3">Email</p>
              <a href={PRACTICE.email.href} class="text-text-strong text-[15px] leading-[1.55] hover:text-accent-600 transition-colors">{PRACTICE.email.display}</a>
            </div>
            <div>
              <p class="eyebrow mb-3">Hours</p>
              <p class="text-text-strong text-[15px] leading-[1.55]">{PRACTICE.hours.weekdays}</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <BookingBand />
</BaseLayout>
