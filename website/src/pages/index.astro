---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import Icon from '../components/ui/Icon.astro';
import harleyStreet from '../assets/images/harley-street.jpg';
import { BOOKING_URL, OPERATOR, PRACTICE, SITE_URL } from '../consts';
import { breadcrumbSchema, faqSchema, itemListSchema, medicalClinicSchema, medicalWebPageSchema, websiteSchema } from '../lib/jsonld';
import { groupHealthChecks, healthCheckUrl, sortHealthChecks } from '../lib/health-checks';

const checks = sortHealthChecks(await getCollection('healthChecks'));
const groups = groupHealthChecks(checks);
const featured = checks.filter((check) => check.data.featured || check.data.commercialPriority).slice(0, 6);
const comparisonSlugs = [
  'premium-health-check',
  'essential-health-screen',
  'well-man-health-check',
  'well-woman-health-check',
  'healthy-heart-check',
  'executive-woman-health-check',
];
const comparisonChecks = comparisonSlugs
  .map((slug) => checks.find((check) => check.id.replace(/\.mdx?$/, '') === slug))
  .filter(Boolean);
const insights = (await getCollection('insights'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const title = 'Private Health Checks London | From £180 | Harley Street';
const description = 'Doctor-led private health checks on Harley Street, London, from £180. Operated by London Harley Street Practice — established 2003.';
const homeFaqs = [
  {
    question: 'How much does a private health check cost in London?',
    answer: 'Private health checks at London Health Check start from £180 for a focused Basic Health Screen. Broader Well Man and Well Woman checks are £690, while specialist and executive packages cost more depending on imaging and testing.',
  },
  {
    question: 'Where can I book a private health check in London?',
    answer: 'Appointments take place at 66 Harley Street, London W1G 7HD, operated by London Harley Street Practice. You can book online through HeyDoc or call the clinic.',
  },
  {
    question: 'What is included in a full health check?',
    answer: 'Inclusions depend on the package. Most checks include a doctor-led consultation, examination, blood tests, urine analysis where listed, risk calculation, and a written report. Advanced packages may include ECG, lung function, ultrasound, or MRI.',
  },
  {
    question: 'Which health check should I choose?',
    answer: 'Most patients starting preventative screening choose Premium, Well Man, or Well Woman. Executive packages are more appropriate if you want whole-body MRI and the broadest investigation panel.',
  },
  {
    question: 'Do I need to fast before a health check?',
    answer: 'Fasting may be required for checks that include lipids or glucose-related markers. The clinic will confirm preparation after you book.',
  },
  {
    question: 'How quickly will I receive results?',
    answer: 'Routine blood results are typically available within one to three working days. Imaging and specialist results may take longer and are incorporated into your written report when available.',
  },
];
const jsonLd = [
  medicalClinicSchema(checks.map((check) => ({
    name: check.data.name,
    url: `${SITE_URL}${healthCheckUrl(check)}`,
    description: check.data.summary,
    price: check.data.price,
    priceValue: check.data.priceValue,
  }))),
  websiteSchema(),
  itemListSchema(checks.map((check) => ({ name: check.data.name, url: `${SITE_URL}${healthCheckUrl(check)}`, description: check.data.summary }))),
  breadcrumbSchema([{ name: 'Home', href: '/' }]),
  faqSchema(homeFaqs),
  medicalWebPageSchema({ name: title, description, url: SITE_URL }),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow" data-reveal>By {OPERATOR.name}</p>
          <h1 class="mt-8 font-display tracking-[-0.04em] leading-[0.94] text-text-strong max-w-[12ch]" style="font-size: clamp(3rem, 8vw, 7.75rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;" data-reveal>
            Private health checks in London — Harley Street<span class="text-accent-400">.</span>
          </h1>
          <p class="mt-8 md:mt-10 max-w-[64ch] text-ink-700" style="font-size: clamp(1.125rem, 0.6vw + 1rem, 1.35rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 260ms;" data-reveal>
            <strong>Private health checks in London</strong>, from focused health screens to Well Man, Well Woman, specialist, and executive medicals at 66 Harley Street.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal style="--reveal-delay: 340ms;">
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 bg-ink-900 text-bg px-7 py-4 rounded-[2px] text-[13px] font-medium tracking-[0.04em] uppercase transition-colors duration-300 hover:bg-accent-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-4 focus-visible:ring-offset-bg">
              <span>Book a health check</span>
              <Icon name="arrow-up-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
            <a href="/health-checks" class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors">Compare checks</a>
          </div>
        </div>
        <aside class="lg:col-span-4 border border-border-soft bg-bg-soft p-7 md:p-9" data-reveal style="--reveal-delay: 300ms;">
          <p class="eyebrow">Harley Street clinic</p>
          <dl class="mt-8 space-y-6">
            <div>
              <dt class="text-[12px] font-mono tracking-[0.12em] uppercase text-text-meta">From</dt>
              <dd class="mt-2 font-display text-text-strong tracking-[-0.02em]" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 340; font-variation-settings: 'opsz' 96, 'SOFT' 40;">£180</dd>
            </div>
            <div>
              <dt class="text-[12px] font-mono tracking-[0.12em] uppercase text-text-meta">Address</dt>
              <dd class="mt-2 text-text-strong text-[15px] leading-[1.55]">{PRACTICE.address.line1}<br />{PRACTICE.address.locality} {PRACTICE.address.postalCode}</dd>
            </div>
            <div>
              <dt class="text-[12px] font-mono tracking-[0.12em] uppercase text-text-meta">Booking</dt>
              <dd class="mt-2"><a href={PRACTICE.phone.href} class="text-text-strong hover:text-accent-600 transition-colors">{PRACTICE.phone.display}</a></dd>
            </div>
          </dl>
        </aside>
      </div>
      <div class="mt-14 grid gap-px bg-border-soft border border-border-soft md:grid-cols-3" data-reveal style="--reveal-delay: 420ms;">
        {['Doctor-led', '66 Harley Street since 2003', 'From £180'].map((item) => (
          <p class="bg-bg px-5 py-4 text-[12px] font-mono uppercase tracking-[0.12em] text-text-meta">{item}</p>
        ))}
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="grid gap-px bg-border-soft border border-border-soft md:grid-cols-3">
        {[
          ['Doctor-led', 'Your health check is built around a consultation, examination, interpretation, and written action plan.'],
          ['Transparent pricing', 'Compare every tier before booking, from short screens to executive medicals.'],
          ['Harley Street trust', `London Health Check is operated by ${OPERATOR.name} at 66 Harley Street.`],
        ].map(([label, copy], i) => (
          <article class="bg-bg p-7 md:p-9" data-reveal style={`--reveal-delay: ${120 + i * 80}ms;`}>
            <Icon name="check-circle" size={24} class="text-accent-600 mb-8" />
            <h2 class="font-display text-text-strong tracking-[-0.02em] leading-[1.08]" style="font-size: clamp(1.5rem, 2vw, 2.25rem); font-weight: 360; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{label}</h2>
            <p class="mt-5 text-text-muted text-[15px] leading-[1.7]">{copy}</p>
          </article>
        ))}
      </div>
      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
        <div>
          <p class="eyebrow" data-reveal>Compare packages</p>
          <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.02] max-w-[15ch]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Compare our health checks.</h2>
        </div>
        <a href="/pricing" class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors" data-reveal>Full pricing</a>
      </div>

      <div class="overflow-x-auto border-y border-border-soft" data-reveal style="--reveal-delay: 160ms;">
        <table class="w-full min-w-[760px] text-left">
          <thead class="border-b border-border-soft">
            <tr class="text-[11px] font-mono uppercase tracking-[0.12em] text-text-meta">
              <th class="py-4 pr-6 font-normal">Health check</th>
              <th class="py-4 px-6 font-normal">Price</th>
              <th class="py-4 px-6 font-normal">Duration</th>
              <th class="py-4 px-6 font-normal">Includes</th>
              <th class="py-4 pl-6 font-normal">Book</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-soft">
            {comparisonChecks.map((check) => (
              <tr>
                <td class="py-6 pr-6 align-top">
                  <a href={healthCheckUrl(check)} class="font-display text-text-strong tracking-[-0.015em] hover:text-accent-600 transition-colors" style="font-size: clamp(1.2rem, 1vw + 1rem, 1.65rem); font-weight: 360; font-variation-settings: 'opsz' 72, 'SOFT' 40;">{check.data.name}</a>
                </td>
                <td class="py-6 px-6 align-top text-text-strong font-medium">{check.data.price}</td>
                <td class="py-6 px-6 align-top text-text-muted">{check.data.duration}</td>
                <td class="py-6 px-6 align-top text-text-muted max-w-[36ch]">
                  <ul class="space-y-1.5">
                    {check.data.includes.slice(0, 3).map((item) => <li>{item}</li>)}
                  </ul>
                </td>
                <td class="py-6 pl-6 align-top">
                  <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-text-strong hover:text-accent-600 transition-colors">
                    <span>Book</span>
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-12 md:mb-16 max-w-[62ch]">
        <p class="eyebrow" data-reveal>Find your check</p>
        <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.02]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Start with the right depth of screening.</h2>
      </div>
      <div class="grid gap-px bg-border-soft border border-border-soft md:grid-cols-4">
        {groups.map((group, i) => (
          <a href={group.href} class="group bg-bg p-7 md:p-8 transition-colors hover:bg-bg-soft" data-reveal style={`--reveal-delay: ${120 + i * 80}ms;`}>
            <p class="eyebrow">{group.label}</p>
            <p class="mt-8 text-text-muted text-[15px] leading-[1.7]">{group.lede}</p>
            <p class="mt-8 inline-flex items-center gap-2 text-text-strong group-hover:text-accent-600 transition-colors">
              <span>View checks</span>
              <Icon name="arrow-up-right" size={14} />
            </p>
          </a>
        ))}
      </div>
      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
        <div>
          <p class="eyebrow" data-reveal>Popular health checks</p>
          <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.02] max-w-[14ch]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Most booked starting points.</h2>
        </div>
        <a href="/pricing" class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors" data-reveal>See all prices</a>
      </div>
      <div class="grid gap-px bg-border-soft border border-border-soft md:grid-cols-2 lg:grid-cols-3">
        {featured.map((check, i) => (
          <article class="bg-bg p-7 md:p-8" data-reveal style={`--reveal-delay: ${120 + i * 60}ms;`}>
            <p class="font-mono text-text-meta text-[11px] tracking-[0.12em] uppercase">{check.data.price} · {check.data.duration}</p>
            <h3 class="mt-6 font-display text-text-strong tracking-[-0.02em] leading-[1.08]" style="font-size: clamp(1.5rem, 2vw, 2.15rem); font-weight: 360; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{check.data.name}</h3>
            <p class="mt-5 text-text-muted text-[15px] leading-[1.65]">{check.data.summary}</p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href={healthCheckUrl(check)} class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors">See details</a>
              <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent-600 transition-colors">Book</a>
            </div>
          </article>
        ))}
      </div>
      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-start">
        <div class="lg:col-span-5">
          <p class="eyebrow" data-reveal>How it works</p>
          <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.02]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Choose, attend, understand.</h2>
          <p class="mt-6 text-text-muted text-[15px] leading-[1.7]" data-reveal style="--reveal-delay: 120ms;">Your check is designed to lead to a clear written report, not a pile of unexplained numbers.</p>
        </div>
        <div class="lg:col-span-7 grid gap-px bg-border-soft border border-border-soft md:grid-cols-2">
          {['Choose your check', 'Book through HeyDoc', 'Attend Harley Street', 'Receive your report'].map((step, i) => (
            <article class="bg-bg p-7 md:p-8" data-reveal style={`--reveal-delay: ${120 + i * 80}ms;`}>
              <p class="font-mono text-text-meta text-[11px] tracking-[0.12em] uppercase">Step {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-6 font-display text-text-strong tracking-[-0.02em] leading-[1.08]" style="font-size: clamp(1.5rem, 2vw, 2rem); font-weight: 360; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{step}</h3>
            </article>
          ))}
        </div>
      </div>
      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-center">
        <figure class="lg:col-span-5" data-reveal>
          <div class="relative aspect-[4/5] overflow-hidden border border-border-soft bg-bg-soft">
            <Image src={harleyStreet} alt="Harley Street in London" class="h-full w-full object-cover grayscale-[12%]" loading="lazy" widths={[420, 640, 840]} sizes="(min-width: 1024px) 34vw, 100vw" />
          </div>
          <figcaption class="mt-3 font-mono text-text-meta" style="font-size: 10px; letter-spacing: 0.12em;">66 HARLEY STREET · W1G</figcaption>
        </figure>
        <div class="lg:col-span-7" data-reveal style="--reveal-delay: 120ms;">
          <p class="eyebrow">Operated by {OPERATOR.name}</p>
          <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.02] max-w-[15ch]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;">A dedicated health check site, backed by a Harley Street practice.</h2>
          <p class="mt-8 max-w-[58ch] text-text-muted text-[15px] leading-[1.7]">London Health Check is the dedicated preventative screening site operated by London Harley Street Practice. Appointments take place at 66 Harley Street, with booking handled through HeyDoc.</p>
          <p class="mt-8"><a href="/about" class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors">About the clinic</a></p>
        </div>
      </div>
      <hr class="hairline mt-16 md:mt-24 lg:mt-32" />
    </Container>
  </section>

  {insights.length > 0 && (
    <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
      <Container class="max-w-[var(--container-page)]">
        <div class="mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
          <div>
            <p class="eyebrow" data-reveal>Health library</p>
            <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.02] max-w-[14ch]" style="font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Reading from our clinicians.</h2>
          </div>
          <a href="/insights" class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors" data-reveal>All articles</a>
        </div>
        <div class="grid gap-px bg-border-soft border border-border-soft md:grid-cols-3">
          {insights.map((article, i) => {
            const slug = article.id.replace(/\/index$/, '');
            return (
              <a href={`/insights/${slug}`} class="group bg-bg p-7 md:p-8 transition-colors hover:bg-bg-soft" data-reveal style={`--reveal-delay: ${120 + i * 80}ms;`}>
                <p class="eyebrow">Health library</p>
                <h3 class="mt-6 font-display text-text-strong tracking-[-0.02em] leading-[1.08] group-hover:text-accent-600 transition-colors" style="font-size: clamp(1.35rem, 1.6vw, 1.9rem); font-weight: 360; font-variation-settings: 'opsz' 96, 'SOFT' 40;">{article.data.title}</h3>
                <p class="mt-5 text-text-muted text-[15px] leading-[1.65]">{article.data.lede}</p>
              </a>
            );
          })}
        </div>
      </Container>
    </section>
  )}

  <section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
    <Container class="max-w-[var(--container-page)]">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <aside class="lg:col-span-4">
          <p class="eyebrow" data-reveal>Questions</p>
          <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.05]" style="font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Before you book.</h2>
        </aside>
        <div class="lg:col-span-8 divide-y divide-border-soft border-y border-border-soft">
          {homeFaqs.map((faq, i) => (
            <details class="group py-6" data-reveal style={`--reveal-delay: ${120 + i * 60}ms;`}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-text-strong">
                <h3 class="font-display tracking-[-0.015em] leading-[1.2]" style="font-size: clamp(1.25rem, 1.2vw + 0.9rem, 1.75rem); font-weight: 360; font-variation-settings: 'opsz' 72, 'SOFT' 40;">{faq.question}</h3>
                <Icon name="plus" size={18} class="mt-1 shrink-0 text-accent-600 transition-transform group-open:rotate-45" />
              </summary>
              <p class="mt-5 max-w-[68ch] text-text-muted text-[15px] leading-[1.7]">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <BookingBand />
</BaseLayout>
