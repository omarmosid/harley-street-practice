---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import CredentialsStrip from '../components/sections/CredentialsStrip.astro';
import Hero from '../components/sections/home/Hero.astro';
import TrustStrip from '../components/sections/home/TrustStrip.astro';
import ComprehensiveCare from '../components/sections/home/ComprehensiveCare.astro';
import FlagshipCallout from '../components/sections/home/FlagshipCallout.astro';
import Differentiators from '../components/sections/home/Differentiators.astro';
import ComparisonTable from '../components/sections/home/ComparisonTable.astro';
import CancerSpecialistGrid from '../components/sections/home/CancerSpecialistGrid.astro';
import WhyChooseUs from '../components/sections/home/WhyChooseUs.astro';
import ClinicalOversight from '../components/sections/home/ClinicalOversight.astro';
import HomeFaqs from '../components/sections/home/HomeFaqs.astro';
import HealthLibraryTeaser from '../components/sections/home/HealthLibraryTeaser.astro';
import { SITE_URL } from '../consts';
import { breadcrumbSchema, faqSchema, itemListSchema, medicalClinicSchema, medicalWebPageSchema, websiteSchema } from '../lib/jsonld';
import { healthCheckUrl, sortHealthChecks } from '../lib/health-checks';

const checks = sortHealthChecks(await getCollection('healthChecks'));
const team = await getCollection('team');
const bySlug = (slug: string) => checks.find((check) => check.id.replace(/\.mdx?$/, '') === slug)!;
const premium = bySlug('premium-health-check');
const clinicalLead = team.find((entry) => entry.id === 'ahmed-bachelani')!;
const comparisonChecks = [
  'premium-health-check',
  'essential-health-screen',
  'well-man-health-check',
  'well-woman-health-check',
  'healthy-heart-check',
  'executive-woman-health-check',
].map(bySlug);

const insights = (await getCollection('insights'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const title = 'Private Health Checks London | From £180 | Harley Street';
const description = 'Doctor-led private health checks on Harley Street, London, from £180. Clear pricing, written reports, and online booking.';
const homeFaqs = [
  {
    question: 'How much does a private health check cost in London?',
    answer: 'Private health checks at London Health Check start from £180 for a focused Basic Health Screen. Broader Well Man and Well Woman checks are £690, while specialist and executive packages cost more depending on imaging and testing.',
  },
  {
    question: 'Where can I book a private health check in London?',
    answer: 'Appointments take place at 66 Harley Street, London W1G 7HD. You can book online or call the clinic.',
  },
  {
    question: 'What is included in a full health check?',
    answer: 'Inclusions depend on the package. Most checks include a doctor-led consultation, examination, blood tests, urine analysis where listed, risk calculation, and a written report. Advanced packages may include ECG, lung function, ultrasound, or MRI.',
  },
  {
    question: 'Which health check should I choose?',
    answer: 'Most patients starting preventative screening choose Premium, Well Man, or Well Woman. Executive packages are more appropriate if you want whole-body MRI and the broadest investigation panel.',
  },
  {
    question: 'Do I need to fast before a health check?',
    answer: 'Fasting may be required for checks that include lipids or glucose-related markers. The clinic will confirm preparation after you book.',
  },
  {
    question: 'How quickly will I receive results?',
    answer: 'Routine blood results are typically available within one to three working days. Imaging and specialist results may take longer and are incorporated into your written report when available.',
  },
];
const jsonLd = [
  medicalClinicSchema(checks.map((check) => ({
    name: check.data.name,
    url: `${SITE_URL}${healthCheckUrl(check)}`,
    description: check.data.summary,
    price: check.data.price,
    priceValue: check.data.priceValue,
  }))),
  websiteSchema(),
  itemListSchema(checks.map((check) => ({ name: check.data.name, url: `${SITE_URL}${healthCheckUrl(check)}`, description: check.data.summary }))),
  breadcrumbSchema([{ name: 'Home', href: '/' }]),
  faqSchema(homeFaqs),
  medicalWebPageSchema({ name: title, description, url: SITE_URL, speakableSelectors: ['#home-faqs'] }),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Hero />
  <TrustStrip />
  <ComprehensiveCare checks={checks} />
  <FlagshipCallout check={premium} />
  <Differentiators />
  <ComparisonTable checks={comparisonChecks} />
  <CancerSpecialistGrid checks={checks} />
  <WhyChooseUs />
  <ClinicalOversight lead={clinicalLead} />
  <CredentialsStrip />
  <HomeFaqs faqs={homeFaqs} />
  <HealthLibraryTeaser insights={insights} />
  <BookingBand />
</BaseLayout>
