---
/**
 * ServiceLayout — wraps a service detail page.
 *
 * Composition:
 *   1. ServiceHero          (eyebrow, title, lede, CTA)
 *   2. (optional) TierGrid  (rendered when frontmatter has tierGroups)
 *   3. ProseSection         (the MDX body)
 *   4. (optional) FAQList   (rendered when frontmatter has faqs)
 *   5. BookingBand          (closing conversion moment, reused from homepage)
 *
 */
import BaseLayout from './BaseLayout.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import TierGrid from '../components/service/TierGrid.astro';
import ProseSection from '../components/service/ProseSection.astro';
import FAQList from '../components/service/FAQList.astro';
import VisaCountryGrid from '../components/service/VisaCountryGrid.astro';
import BookingBand from '../components/sections/BookingBand.astro';
import { getCollection } from 'astro:content';
import { SITE_NAME, SITE_URL } from '../consts';

type Tier = {
  name: string;
  price: string;
  duration?: string;
  description?: string;
  includes: string[];
  featured: boolean;
  anchor?: string;
};

type Group = {
  heading?: string;
  lede?: string;
  tiers: Tier[];
};

type Props = {
  title: string;
  shortTitle?: string;
  lede: string;
  seoTitle: string;
  seoDescription: string;
  supportLine?: string;
  tierGroups?: Group[];
  faqs?: { question: string; answer: string }[];
  /** Slug used for canonical URL. */
  slug: string;
  /** Whether to render the visa country grid below the prose body. */
  showVisaCountries?: boolean;
};

const {
  title,
  shortTitle,
  lede,
  seoTitle,
  seoDescription,
  supportLine,
  tierGroups = [],
  faqs = [],
  slug,
  showVisaCountries = false,
} = Astro.props;

const visaCountries = showVisaCountries
  ? (await getCollection('visaCountries')).sort((a, b) =>
      a.data.country.localeCompare(b.data.country, 'en-GB'),
    )
  : [];

const canonical = `${SITE_URL}/services/${slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalService',
  name: title,
  description: lede,
  provider: {
    '@type': 'MedicalBusiness',
    name: SITE_NAME,
    url: SITE_URL,
  },
  url: canonical,
  ...(faqs.length > 0 && {
    mainEntityOfPage: {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  }),
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <ServiceHero
    eyebrow={shortTitle ?? title}
    title={title}
    lede={lede}
    supportLine={supportLine}
  />

  <!-- 2. Tier grid (optional). -->
  {tierGroups.length > 0 && (
    <TierGrid
      eyebrow="Choose your check"
      groups={tierGroups}
    />
  )}

  <!-- 3. Prose body (MDX). -->
  <ProseSection eyebrow="In detail">
    <slot />
  </ProseSection>

  <!-- 4. Visa country grid (optional). -->
  {showVisaCountries && (
    <VisaCountryGrid
      eyebrow="Destinations"
      countries={visaCountries}
    />
  )}

  <!-- 5. FAQs (optional). -->
  {faqs.length > 0 && (
    <FAQList
      eyebrow="Questions"
      faqs={faqs}
    />
  )}

  <!-- 6. Closing booking band. -->
  <BookingBand />
</BaseLayout>
