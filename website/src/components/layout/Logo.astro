---
/**
 * Logo — original wordmark provided by the practice.
 *
 * The gold wordmark is used consistently across the site to preserve the
 * practice's existing brand identity.
 */
import { Image } from 'astro:assets';
import { cn } from '../../lib/cn';
import logoGold from '../../assets/brand/logo-gold.png';

type Props = {
  variant?: 'light' | 'dark';
  /** Visual height of the wordmark in px. Default: 40 (header). */
  height?: number;
  class?: string;
};
const { height = 40, class: className = '' } = Astro.props;

const src = logoGold;
---

<a
  href="/"
  class={cn('inline-flex items-center', className)}
  aria-label="London Harley Street Practice — home"
>
  <Image
    src={src}
    alt="London Harley Street Practice"
    height={height}
    widths={[height * 2, height * 3, height * 4]}
    sizes={`${height * 4}px`}
    style={`height: ${height}px; width: auto;`}
    loading="eager"
  />
</a>
