---
/** Footer — health-check-focused colophon. */
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';
import { OPERATOR, PRACTICE, SITE_NAME } from '../../consts';

const year = new Date().getFullYear();

const healthChecks = [
  { label: 'All health checks', href: '/health-checks' },
  { label: 'Quick screens', href: '/health-checks#quick-screens' },
  { label: 'Comprehensive checks', href: '/health-checks#comprehensive-checks' },
  { label: 'Specialist checks', href: '/health-checks#specialist-checks' },
  { label: 'Executive checks', href: '/health-checks#executive-checks' },
  { label: 'Pricing', href: '/pricing' },
];

const practice = [
  { label: 'How it works', href: '/how-it-works' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const library = [
  { label: 'Health library', href: '/insights' },
  { label: 'Heart health', href: '/insights/heart-health-101' },
  { label: 'Vitamin D', href: '/insights/the-sunshine-vitamin' },
  { label: 'Menopause', href: '/insights/a-flash-of-wisdom-navigating-the-hormone-rollercoaster' },
];

const legal = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Comments & complaints', href: '/comments-and-complaints' },
  { label: 'Terms', href: '/membership/terms' },
];
---

<footer class="bg-bg border-t border-border-soft">
  <Container class="pt-20 md:pt-28 pb-10">
    <div class="grid gap-12 md:gap-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo height={64} />

        <p class="mt-6 max-w-sm text-[15px] text-text-muted leading-[1.65]">
          {SITE_NAME} is a dedicated private health check website operated by <a href={OPERATOR.url} target="_blank" rel="noopener noreferrer" class="text-text-strong hover:text-accent-600 transition-colors">{OPERATOR.name}</a> at 66 Harley Street.
        </p>

        <ul class="mt-8 space-y-2.5 text-[14px] text-text">
          <li>
            <a href={PRACTICE.phone.href} class="inline-flex items-center gap-2 text-text-strong hover:text-accent-600 transition-colors">
              <Icon name="phone" size={14} class="text-accent-600" />
              {PRACTICE.phone.display}
            </a>
          </li>
          <li>
            <a href={PRACTICE.email.href} class="inline-flex items-center gap-2 text-text hover:text-accent-600 transition-colors">
              <Icon name="envelope" size={14} class="text-accent-600" />
              {PRACTICE.email.display}
            </a>
          </li>
          <li class="inline-flex items-start gap-2 text-text-muted">
            <Icon name="map-pin" size={14} class="text-accent-600 mt-1" />
            <span>{PRACTICE.address.line1}<br />{PRACTICE.address.locality} {PRACTICE.address.postalCode}</span>
          </li>
        </ul>

        <p class="mt-8 text-text-meta" style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;">
          {PRACTICE.hours.weekdays.toUpperCase()}<br />
          {PRACTICE.hours.weekends.toUpperCase()}
        </p>
      </div>

      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-12">
        <div>
          <h3 class="eyebrow">Health Checks</h3>
          <ul class="mt-5 space-y-2.5 text-[14px]">
            {healthChecks.map((item) => (
              <li><a href={item.href} class="text-text-muted hover:text-text-strong transition-colors">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="eyebrow">Practice</h3>
          <ul class="mt-5 space-y-2.5 text-[14px]">
            {practice.map((item) => (
              <li><a href={item.href} class="text-text-muted hover:text-text-strong transition-colors">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="eyebrow">Health Library</h3>
          <ul class="mt-5 space-y-2.5 text-[14px]">
            {library.map((item) => (
              <li><a href={item.href} class="text-text-muted hover:text-text-strong transition-colors">{item.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <hr class="hairline mt-20" />
    <div class="mt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-[12px] text-text-meta">
      <p>&copy; {year} {SITE_NAME}. Operated by {OPERATOR.name}. Registered in England.</p>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {legal.map((item) => (
          <li><a href={item.href} class="hover:text-text-strong transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </Container>
</footer>
