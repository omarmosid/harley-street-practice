---
/**
 * ServiceHero — masthead for a service detail page.
 *
 * Mirrors the homepage hero rhythm with one CTA, one quiet phone link, and one
 * mono support line.
 *
 * Why no image: most services don't earn one. The page already commits
 * to type. If a service genuinely needs imagery (e.g. a clinic photo),
 * include it as an MDX block lower down.
 */
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { PRACTICE, bookingUrl } from '../../consts';

type Props = {
  /** Eyebrow label, e.g. "Private GP". */
  eyebrow: string;
  /** Page H1, set in Fraunces. */
  title: string;
  /** Headline lede paragraph. */
  lede: string;
  /** Mono support line under the CTA, e.g. "From £180. Same-day appointments." */
  supportLine?: string;
};

const { eyebrow, title, lede, supportLine } = Astro.props;
---

<section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0">
  <Container class="max-w-[var(--container-page)]">

    <div class="mb-10 md:mb-14">
      <p
        class="eyebrow"
        style="--reveal-delay: 80ms;"
        data-reveal
      >{eyebrow}</p>
    </div>

    <!-- Title. -->
    <h1
      class="font-display tracking-[-0.035em] leading-[0.96] text-text-strong"
      style="font-size: clamp(2.5rem, 7vw, 6.5rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50, 'WONK' 0; text-wrap: balance; --reveal-delay: 160ms;"
      data-reveal
    >
      {title}<span class="text-accent-400">.</span>
    </h1>

    <!-- Lede. -->
    <p
      class="mt-8 md:mt-10 max-w-[58ch] text-ink-700"
      style="font-size: clamp(1.0625rem, 0.5vw + 0.95rem, 1.25rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 280ms;"
      data-reveal
    >
      {lede}
    </p>

    <!-- CTA cluster. -->
    <div
      class="mt-10 md:mt-14 flex flex-wrap items-center gap-x-10 gap-y-7"
      style="--reveal-delay: 380ms;"
      data-reveal
    >
      <a
        href={bookingUrl('service-hero')}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 bg-accent-400 text-accent-900 px-7 py-4 rounded-[2px] text-[14px] font-medium tracking-[0.02em] uppercase transition-colors duration-300 hover:bg-accent-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-4 focus-visible:ring-offset-bg"
      >
        <span>Book an appointment</span>
        <Icon name="arrow-up-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>

      <a
        href={PRACTICE.phone.href}
        class="group inline-flex items-baseline gap-2 text-text-strong text-[15px] tracking-tight transition-colors duration-200 hover:text-accent-600"
      >
        <span class="text-text-meta">Or call</span>
        <span class="font-medium underline decoration-1 underline-offset-[6px] decoration-ink-300 transition-[text-decoration-color] duration-200 group-hover:decoration-accent-400">
          {PRACTICE.phone.display}
        </span>
      </a>
    </div>

    {supportLine && (
      <p
        class="mt-8 font-mono text-text-meta"
        style="font-size: 11px; letter-spacing: 0.14em; --reveal-delay: 480ms;"
        data-reveal
      >
        {supportLine.toUpperCase()}
      </p>
    )}

    <!-- Closing hairline. The next section's pt-* provides the gap. -->
    <hr class="hairline mt-16 md:mt-24 lg:mt-32" />

  </Container>
</section>
