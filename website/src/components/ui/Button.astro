---
/**
 * Button — renders <a> if href provided, else <button>.
 * Variants: primary, secondary, ghost, link.
 * Sizes: sm, md (default), lg.
 *
 * External links automatically get target=_blank + rel + an "external" icon.
 *
 * Usage:
 *   <Button href="/contact">Contact</Button>
 *   <Button href={bookingUrl('cta-location')} variant="primary" external icon="calendar-check">Book appointment</Button>
 *   <Button variant="ghost" size="sm">Learn more</Button>
 */
import Icon from './Icon.astro';
import { cn } from '../../lib/cn';

type Variant = 'primary' | 'secondary' | 'ghost' | 'link';
type Size = 'sm' | 'md' | 'lg';

type Props = {
  href?: string;
  variant?: Variant;
  size?: Size;
  external?: boolean;
  icon?: Parameters<typeof Icon>[0]['name'];
  iconRight?: Parameters<typeof Icon>[0]['name'];
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  'aria-label'?: string;
};

const {
  href,
  variant = 'primary',
  size = 'md',
  external,
  icon,
  iconRight,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-medium tracking-tight rounded-[2px] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2 focus-visible:ring-offset-bg disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap';

const variants: Record<Variant, string> = {
  primary:
    'bg-accent-400 text-accent-900 shadow-sm hover:bg-accent-100 hover:shadow-md active:translate-y-px',
  secondary:
    'bg-surface text-text-strong border border-border-soft hover:border-accent-400',
  ghost:
    'bg-transparent text-text-strong hover:bg-bg-soft',
  link:
    'bg-transparent text-text-strong underline underline-offset-4 hover:text-accent-600 px-0 py-0',
};

const sizes: Record<Size, string> = {
  sm: 'h-9 px-3 text-sm',
  md: 'h-11 px-5 text-[15px]',
  lg: 'h-12 px-6 text-base',
};

// `link` variant shouldn't have height/padding from the size scale
const sizeClass = variant === 'link' ? '' : sizes[size];

// Use cn (tailwind-merge) so the caller's `class` prop can cleanly
// override variant tokens (e.g. bg-* color) without duplication.
const classes = cn(base, variants[variant], sizeClass, className);

const isExternal =
  external ?? (typeof href === 'string' && /^https?:\/\//.test(href) && !href.includes('londonhealthcheck.uk'));

const externalAttrs = isExternal && href ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const iconSize = size === 'sm' ? 16 : size === 'lg' ? 22 : 18;
---

{href ? (
  <a href={href} class={classes} {...externalAttrs} {...rest}>
    {icon && <Icon name={icon} size={iconSize} />}
    <slot />
    {iconRight && <Icon name={iconRight} size={iconSize} />}
    {isExternal && !iconRight && <Icon name="arrow-up-right" size={iconSize} class="opacity-70" />}
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    {icon && <Icon name={icon} size={iconSize} />}
    <slot />
    {iconRight && <Icon name={iconRight} size={iconSize} />}
  </button>
)}
