---
/**
 * Icon — thin compatibility wrapper around phosphor-astro.
 *
 * Keeping the local wrapper preserves the existing `name` API while moving the
 * actual SVG definitions to the maintained phosphor-astro package.
 */
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';
import CalendarCheck from 'phosphor-astro/CalendarCheck.astro';
import CaretDown from 'phosphor-astro/CaretDown.astro';
import CaretRight from 'phosphor-astro/CaretRight.astro';
import Check from 'phosphor-astro/Check.astro';
import CheckCircle from 'phosphor-astro/CheckCircle.astro';
import Clock from 'phosphor-astro/Clock.astro';
import Envelope from 'phosphor-astro/Envelope.astro';
import FacebookLogo from 'phosphor-astro/FacebookLogo.astro';
import Flask from 'phosphor-astro/Flask.astro';
import Heart from 'phosphor-astro/Heart.astro';
import InstagramLogo from 'phosphor-astro/InstagramLogo.astro';
import List from 'phosphor-astro/List.astro';
import MapPin from 'phosphor-astro/MapPin.astro';
import Phone from 'phosphor-astro/Phone.astro';
import Plus from 'phosphor-astro/Plus.astro';
import Quotes from 'phosphor-astro/Quotes.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import Stethoscope from 'phosphor-astro/Stethoscope.astro';
import X from 'phosphor-astro/X.astro';
import XLogo from 'phosphor-astro/XLogo.astro';

const ICONS = {
  phone: Phone,
  envelope: Envelope,
  'map-pin': MapPin,
  clock: Clock,
  'calendar-check': CalendarCheck,
  'arrow-up-right': ArrowUpRight,
  'caret-right': CaretRight,
  'caret-down': CaretDown,
  check: Check,
  'check-circle': CheckCircle,
  quotes: Quotes,
  stethoscope: Stethoscope,
  heart: Heart,
  'shield-check': ShieldCheck,
  list: List,
  x: X,
  flask: Flask,
  plus: Plus,
  'instagram-logo': InstagramLogo,
  'x-logo': XLogo,
  'facebook-logo': FacebookLogo,
} as const;

type Props = {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
  title?: string;
};

const { name, size = 24, class: className = '', title, ...rest } = Astro.props;
const Component = ICONS[name];
const ariaHidden = title ? 'false' : (rest['aria-hidden'] ?? 'true');
---

<Component
  width={size}
  height={size}
  class={className}
  aria-hidden={ariaHidden}
  aria-label={title}
  role={title ? 'img' : undefined}
  {...rest}
/>
