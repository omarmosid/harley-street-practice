---
/**
 * TheDoctor — section 4 of the homepage.
 *
 * The first photograph on the page, deliberately delayed until the type
 * has earned the visit. Asymmetric editorial spread: portrait on the
 * left, large pull-statement on the right.
 *
 * Architecture (desktop, 12-col):
 *   col 1-5  → portrait (tall aspect, full-bleed-feeling)
 *   col 7-12 → eyebrow + large Fraunces pull-statement + attribution + link
 *
 * The pull-statement is intentionally NOT in first-person quote marks.
 * Instead it's framed as the practice's third-person account of Dr
 * Bachelani's approach, drawn from the public team biography. This keeps
 * us factually honest while reading like a magazine pull-quote.
 *
 * Mobile: portrait stacks on top, text below.
 *
 * Motion: portrait fades up first, then eyebrow → pull-statement →
 * attribution → link with stagger.
 */
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import portrait from '../../assets/images/dr-bachelani.png';
---

<section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
  <Container class="max-w-[var(--container-page)]">

    <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-20 items-start">

      <!-- Portrait.
           Tall aspect on desktop (3:4) so it reads as a considered
           portrait, not a casual snapshot. Subtle ring + hairline rule
           overlay below as a printed-photo cue. -->
      <figure
        class="md:col-span-5 mb-12 md:mb-0"
        data-reveal
      >
        <div class="relative overflow-hidden bg-bg-soft">
          <Image
            src={portrait}
            alt="Dr Ahmed Bachelani, founding physician at the London Harley Street Practice"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="aspect-[3/4] w-full object-cover"
            loading="lazy"
          />
        </div>
        <figcaption
          class="mt-4 font-mono text-text-meta flex items-center justify-between"
          style="font-size: 11px; letter-spacing: 0.12em;"
        >
          <span>DR AHMED BACHELANI</span>
          <span>FOUNDING PHYSICIAN</span>
        </figcaption>
      </figure>

      <!-- Pull-statement column. -->
      <div class="md:col-span-7 md:pt-4 lg:pt-8">

        <div class="mb-8 md:mb-10">
          <p
            class="eyebrow"
            style="--reveal-delay: 80ms;"
            data-reveal
          >The doctor</p>
        </div>

        <!-- Pull-statement.
             Editorial pull-text, NOT a direct quote — it's the practice's
             account of Dr Bachelani's approach, drawn from the public team
             biography. The bronze opening rule (not a quote mark) reinforces
             that this is editorial framing, not invented speech. -->
        <p
          class="font-display text-text-strong relative"
          style="font-size: clamp(1.625rem, 1.8vw + 1rem, 2.625rem); font-weight: 360; line-height: 1.18; letter-spacing: -0.02em; font-variation-settings: 'opsz' 60, 'SOFT' 30; text-wrap: balance; --reveal-delay: 200ms;"
          data-reveal
        >
          <span class="block w-12 h-px bg-accent-400 mb-6 md:mb-8" aria-hidden="true"></span>
          Twenty-five years in medicine. A practice built around attentive listening, careful examination, and the kind of relationship with a doctor that medicine used to have time for.
        </p>

        <!-- Attribution. -->
        <div
          class="mt-10 md:mt-14 flex flex-col gap-1.5 text-[14px] tracking-tight text-text-muted"
          style="--reveal-delay: 360ms;"
          data-reveal
        >
          <p class="text-text-strong font-medium">Dr Ahmed Bachelani</p>
          <p class="font-mono uppercase tracking-[0.08em]" style="font-size: 11px; letter-spacing: 0.1em;">
            MBBS &middot; MRCP &middot; MRCGP &middot; DOccMed &middot; BSc
          </p>
          <p class="mt-1 text-text-muted">
            Founding physician. Twenty-five years in private and hospital medicine. Member of the Royal College of Physicians and the Royal College of General Practitioners.
          </p>
        </div>

        <!-- Quiet link to the full team page. -->
        <a
          href="/team"
          class="group mt-10 md:mt-12 inline-flex items-center gap-2 text-text-strong text-[14px] tracking-tight transition-colors duration-200 hover:text-accent-600"
          style="--reveal-delay: 480ms;"
          data-reveal
        >
          <span class="underline decoration-1 underline-offset-[6px] decoration-ink-300 transition-[text-decoration-color] duration-200 group-hover:decoration-accent-400">Meet the full team</span>
          <Icon name="arrow-up-right" size={14} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>

      </div>

    </div>

    <!-- Closing hairline. Mirrors the rhythm of earlier sections. -->
    <hr
      class="hairline mt-20 md:mt-28 lg:mt-32"
      style="--reveal-delay: 600ms;"
      data-reveal
    />

  </Container>
</section>
