---
/**
 * OpeningStatement — section 2 of the homepage.
 *
 * Editorial "masthead" / opening letter. Two short paragraphs in Fraunces at
 * sub-display size that state the practice's POV before the page asks for
 * anything. Like the editor's letter at the front of a magazine.
 *
 * Architecture (12-col grid on desktop):
 *   col 1     → section label
 *   col 2-12  → editorial body (drop-cap'd paragraph, second paragraph,
 *               then a quiet signature)
 *
 * Why a 1-col index instead of a 4-col one: the previous version had a vast
 * empty whitespace on the left that made the paragraph feel orphaned.
 * Pulling the body left gives a tighter editorial spread that still leaves
 * generous outside margin.
 *
 * Typography:
 *   - Body uses Fraunces (display family) at TEXT optical size (opsz 30) —
 *     so it reads as serene editorial prose, not display poster type.
 *   - Drop-cap is opsz 144 (display) for stroke contrast at large size.
 *
 * Motion: label, paragraphs, signature fade-up with stagger.
 */
import Container from '../ui/Container.astro';
---

<section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0">
  <Container class="max-w-[var(--container-page)]">

    <!-- Editorial layout:
         Mobile: stacks (eyebrow on top, body below).
         Desktop: 12-col, narrow left index col + wider body. -->
    <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16">

      <!-- Left label column (sticky-feeling, but not actually sticky). -->
      <aside class="md:col-span-3 lg:col-span-3 mb-10 md:mb-0">
        <div>
          <p
            class="eyebrow"
            style="--reveal-delay: 80ms;"
            data-reveal
          >On the practice</p>
        </div>
      </aside>

      <!-- Body column.
           Two short paragraphs that flow as one editorial thought.
           First paragraph carries the drop-cap; second is plain. -->
      <div class="md:col-span-9 lg:col-span-8">

        <p
          class="dropcap font-display text-text-strong"
          style="font-size: clamp(1.5rem, 1.4vw + 1rem, 2rem); font-weight: 380; line-height: 1.32; letter-spacing: -0.014em; font-variation-settings: 'opsz' 30, 'SOFT' 30, 'WONK' 0; text-wrap: pretty; --reveal-delay: 160ms;"
          data-reveal
        >
          This is a doctor-led practice on Harley Street &mdash; not a clinic optimised for throughput. We see fewer patients, for longer. Thirty minutes is a starting point, not a maximum.
        </p>

        <p
          class="mt-8 md:mt-10 font-display text-text-strong"
          style="font-size: clamp(1.5rem, 1.4vw + 1rem, 2rem); font-weight: 380; line-height: 1.32; letter-spacing: -0.014em; font-variation-settings: 'opsz' 30, 'SOFT' 30, 'WONK' 0; text-wrap: pretty; --reveal-delay: 280ms;"
          data-reveal
        >
          We listen first, examine carefully, and explain what we find. When investigations are needed, they happen here, under one roof. The aim is not simply to treat what brings you in &mdash; but to know your health well enough to keep you out of trouble.
        </p>

        <!-- Signature / attribution.
             Quietly asserts the editorial voice (the practice itself). -->
        <p
          class="mt-10 md:mt-14 eyebrow"
          style="--reveal-delay: 400ms;"
          data-reveal
        >
          The London Harley Street Practice
        </p>

      </div>

    </div>

    <!-- Closing hairline. Mirrors the hero's hairline so the page reads as
         a series of editorial spreads. -->
    <hr
      class="hairline mt-20 md:mt-28 lg:mt-32"
      style="--reveal-delay: 520ms;"
      data-reveal
    />

  </Container>
</section>
