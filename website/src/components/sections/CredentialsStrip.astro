---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import fom from '../../assets/credentials/fom.png';
import rcgp from '../../assets/credentials/rcgp.png';
import gmc from '../../assets/credentials/gmc.jpg';
import rcp from '../../assets/credentials/rcp.png';
import universityOfLondon from '../../assets/credentials/university-of-london.png';

const credentials = [
  { name: 'Faculty of Occupational Medicine', image: fom, class: 'max-w-[150px]' },
  { name: 'Royal College of General Practitioners', image: rcgp, class: 'max-w-[150px]' },
  { name: 'General Medical Council', image: gmc, class: 'max-w-[116px]' },
  { name: 'Royal College of Physicians', image: rcp, class: 'max-w-[164px]' },
  { name: 'University of London', image: universityOfLondon, class: 'max-w-[150px]' },
];
---

<section class="relative bg-bg pt-16 md:pt-24 pb-0">
  <Container class="max-w-[var(--container-page)]">
    <div class="border-y border-border-soft py-8 md:py-10">
      <p class="eyebrow text-center" data-reveal>Credentials & accreditations</p>
      <div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-3 lg:grid-cols-5 items-center justify-items-center">
        {credentials.map((item, i) => (
          <div class="h-12 md:h-14 flex items-center justify-center" data-reveal style={`--reveal-delay: ${120 + i * 50}ms;`}>
            <Image
              src={item.image}
              alt={item.name}
              class:list={[
                'max-h-full w-auto object-contain grayscale brightness-0 invert opacity-70',
                item.class,
              ]}
              loading="lazy"
              widths={[120, 180, 240, 320]}
              sizes="(min-width: 1024px) 14vw, 38vw"
            />
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-3xl text-center text-text-muted text-[14px] leading-[1.7]" data-reveal style="--reveal-delay: 420ms;">
        <span class="md:hidden">Private health checks at 66 Harley Street.</span>
        <span class="hidden md:inline">Private health checks at 66 Harley Street, supported by clinicians registered with and trained through recognised UK medical institutions including the GMC, RCGP, RCP, FOM and University of London.</span>
      </p>
    </div>
  </Container>
</section>
