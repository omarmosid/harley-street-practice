---
import Container from '../../ui/Container.astro';
import Icon from '../../ui/Icon.astro';
import { BOOKING_URL, PRACTICE } from '../../../consts';
---

<section class="relative bg-bg pt-10 md:pt-24 lg:pt-32 pb-0 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-70" aria-hidden="true">
    <div class="absolute -top-40 -right-32 h-[34rem] w-[34rem] rounded-full bg-accent-400/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 h-[28rem] w-[28rem] rounded-full bg-bg-soft/80 blur-3xl"></div>
  </div>
  <Container class="relative max-w-[var(--container-page)]">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 items-end">
      <div class="lg:col-span-8">
        <h1 class="font-display tracking-[-0.035em] leading-[0.98] text-text-strong md:max-w-[13ch]" style="font-size: clamp(2rem, 6.2vw, 5.9rem); font-weight: 320; font-variation-settings: 'opsz' 144, 'SOFT' 50; text-wrap: balance; --reveal-delay: 160ms;" data-reveal>
          Understand your health risks. Plan your next steps<span class="text-accent-400">.</span>
        </h1>
        <p class="mt-8 md:mt-10 max-w-[64ch] text-ink-700" style="font-size: clamp(1.125rem, 0.6vw + 1rem, 1.35rem); line-height: 1.55; text-wrap: pretty; --reveal-delay: 260ms;" data-reveal>
          <strong>Private health checks in London</strong>, combining doctor-led consultation, examination, blood testing and written clinical context from 66 Harley Street.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal style="--reveal-delay: 340ms;">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 bg-accent-400 text-accent-900 px-7 py-4 rounded-[2px] text-[13px] font-medium tracking-[0.04em] uppercase transition-colors duration-300 hover:bg-accent-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-4 focus-visible:ring-offset-bg">
            <span>Book a health check</span>
            <Icon name="arrow-up-right" size={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
          <a href="/health-checks" class="text-text-strong underline decoration-1 underline-offset-[6px] decoration-ink-300 hover:text-accent-600 hover:decoration-accent-400 transition-colors">See all checks</a>
        </div>
      </div>
      <aside class="lg:col-span-4 border border-border-soft bg-bg-soft/90 p-7 md:p-9" data-reveal style="--reveal-delay: 300ms;">
        <dl class="mt-8 space-y-6">
          <div>
            <dt class="text-[12px] font-mono tracking-[0.12em] uppercase text-text-meta">From</dt>
            <dd class="mt-2 font-display text-text-strong tracking-[-0.02em]" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 340; font-variation-settings: 'opsz' 96, 'SOFT' 40;">£180</dd>
          </div>
          <div>
            <dt class="text-[12px] font-mono tracking-[0.12em] uppercase text-text-meta">Address</dt>
            <dd class="mt-2 text-text-strong text-[15px] leading-[1.55]">{PRACTICE.address.line1}<br />{PRACTICE.address.locality} {PRACTICE.address.postalCode}</dd>
          </div>
          <div>
            <dt class="text-[12px] font-mono tracking-[0.12em] uppercase text-text-meta">Booking</dt>
            <dd class="mt-2"><a href={PRACTICE.phone.href} class="text-text-strong hover:text-accent-600 transition-colors">{PRACTICE.phone.display}</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </Container>
</section>
