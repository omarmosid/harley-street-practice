---
import Container from '../../ui/Container.astro';
import Icon from '../../ui/Icon.astro';

type Props = { faqs: Array<{ question: string; answer: string }> };
const { faqs } = Astro.props;
---

<section id="home-faqs" class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-0 scroll-mt-28">
  <Container class="max-w-[var(--container-page)]">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-4">
        <p class="eyebrow" data-reveal>Questions</p>
        <h2 class="mt-8 font-display text-text-strong tracking-[-0.025em] leading-[1.05]" style="font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 340; font-variation-settings: 'opsz' 144, 'SOFT' 40; text-wrap: balance;" data-reveal>Before you book.</h2>
      </aside>
      <div class="lg:col-span-8 divide-y divide-border-soft border-y border-border-soft">
        {faqs.map((faq, i) => (
          <details class="group py-6" data-reveal style={`--reveal-delay: ${120 + i * 60}ms;`}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-text-strong">
              <h3 class="font-display tracking-[-0.015em] leading-[1.2]" style="font-size: clamp(1.25rem, 1.2vw + 0.9rem, 1.75rem); font-weight: 360; font-variation-settings: 'opsz' 72, 'SOFT' 40;">{faq.question}</h3>
              <Icon name="plus" size={18} class="mt-1 shrink-0 text-accent-600 transition-transform group-open:rotate-45" />
            </summary>
            <p class="mt-5 max-w-[68ch] text-text-muted text-[15px] leading-[1.7]">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
