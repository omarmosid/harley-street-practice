---
/**
 * ServicesGrid — grid of service tiles. Used on the home page.
 * The list is currently inline; once the `services` content collection is in
 * place we'll replace this with `getCollection('services').slice(0,6)`.
 */
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

import privateGp from '../../assets/images/private-gp.jpg';
import healthChecks from '../../assets/images/health-checks.jpg';
import team from '../../assets/images/team.png';
import visa from '../../assets/images/visa-medicals.png';
import musculoskeletal from '../../assets/images/musculoskeletal.jpg';
import counselling from '../../assets/images/counselling.jpg';

const services = [
  {
    title: 'Private GP',
    blurb: 'Same-day appointments with experienced GPs. 30-minute consultations, clear diagnoses, and rapid referrals when needed.',
    href: '/services/private-gp',
    image: privateGp,
    alt: 'A GP listening attentively to a patient during a consultation',
  },
  {
    title: 'Health checks',
    blurb: 'Doctor-led screening with clinical assessment, examination, and diagnostics — designed for early detection.',
    href: '/services/health-checks',
    image: healthChecks,
    alt: 'A clinician reviewing health screening results with a patient',
  },
  {
    title: 'Membership',
    blurb: 'Priority access, discounted rates, and continuity of care from the practice you trust.',
    href: '/membership',
    image: team,
    alt: 'The London Harley Street Practice team in the clinic',
  },
  {
    title: 'Visa medicals',
    blurb: 'FCO-registered physicians completing visa assessments for over 25 countries — same-day, all in one visit.',
    href: '/services/visa-medicals',
    image: visa,
    alt: 'Documents and stethoscope arranged on a desk for a visa medical',
  },
  {
    title: 'Musculoskeletal',
    blurb: 'Hands-on assessment and treatment for back, neck, and joint problems, sports injuries, and postural strain.',
    href: '/services/musculoskeletal',
    image: musculoskeletal,
    alt: 'A practitioner performing a manual therapy treatment',
  },
  {
    title: 'Counselling & psychotherapy',
    blurb: 'Confidential, individualised support for mental health, emotional wellbeing, and personal development.',
    href: '/services/counselling',
    image: counselling,
    alt: 'A calm therapy room with two chairs facing each other',
  },
];
---

<Section id="services" tone="default" size="md">
  <Container>
    <SectionHeading
      eyebrow="What we offer"
      title="Doctor-led care across the disciplines that matter most"
      lead="From same-day GP appointments to in-depth screening, our multidisciplinary team gives you joined-up healthcare from a single clinic."
    />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <li>
          <a
            href={service.href}
            class="group block h-full rounded-xl bg-surface border border-border/60 overflow-hidden shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 hover:border-brand-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-700/20"
          >
            <div class="relative overflow-hidden aspect-[16/10] bg-brand-50">
              <Image
                src={service.image}
                alt={service.alt}
                widths={[400, 600, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </div>
            <div class="p-6">
              <h3 class="font-display text-xl font-medium text-text-strong group-hover:text-brand-900">
                {service.title}
              </h3>
              <p class="mt-3 text-[15px] text-text-muted leading-relaxed line-clamp-3">
                {service.blurb}
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 group-hover:text-brand-900">
                Learn more
                <Icon name="caret-right" size={16} class="transition-transform duration-200 group-hover:translate-x-0.5" />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</Section>
