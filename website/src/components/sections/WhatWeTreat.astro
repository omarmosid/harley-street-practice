---
/**
 * WhatWeTreat — section 3 of the homepage.
 *
 * Editorial typographic index of services. Inspired by magazine table-of-
 * contents pages and brand catalogues (Aesop, Soho House, Acne Studios).
 *
 * Architecture (desktop):
 *   col 1   → mono "03 / 06" + "WHAT WE TREAT" eyebrow + brief lede
 *   col 2   → list of 6 service rows. Each row:
 *               number  ·  large Fraunces name  ·  short descriptor  ·  arrow
 *
 * On hover (desktop):
 *   - the row's accent rule slides from 0% to 100% width
 *   - the arrow translates up-and-right
 *   - the row title slightly shifts (text-strong → ink lightens? no — keep
 *     restraint, only the arrow + rule move)
 *
 * Mobile: the eyebrow stacks above the list. Same rows, same hover treatment
 * collapsed to active state on tap.
 *
 * Why no images here: we already commit to type in the hero. Repeating that
 * commitment in section 3 makes the design opinionated, not decorative.
 * Photographs come later (section 4: the doctor).
 */
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

type Service = {
  num: string;
  name: string;
  blurb: string;
  href: string;
};

const services: Service[] = [
  {
    num: '01',
    name: 'Private GP',
    blurb: 'Same-day, 30-minute consultations with experienced physicians',
    href: '/services/private-gp',
  },
  {
    num: '02',
    name: 'Health checks',
    blurb: 'From baseline screening to executive whole-body assessments',
    href: '/services/health-checks',
  },
  {
    num: '03',
    name: 'Visa medicals',
    blurb: 'Authorised certificates for over thirty countries',
    href: '/services/visa-medicals',
  },
  {
    num: '04',
    name: 'Musculoskeletal',
    blurb: 'Chiropractic and physiotherapy, integrated with GP care',
    href: '/services/musculoskeletal',
  },
  {
    num: '05',
    name: 'Counselling',
    blurb: 'Psychological assessment, therapy, and ongoing support',
    href: '/services/counselling',
  },
  {
    num: '06',
    name: 'Online doctor',
    blurb: 'Virtual consultations, prescriptions, and second opinions',
    href: '/services/online-doctor',
  },
];
---

<section class="relative bg-bg pt-16 md:pt-28 lg:pt-36 pb-16 md:pb-28 lg:pb-36">
  <Container class="max-w-[var(--container-page)]">

    <div class="md:grid md:grid-cols-12 md:gap-12 lg:gap-16">

      <!-- Left index column.
           Same pattern as section 2 for a consistent editorial spread. -->
      <aside class="md:col-span-4 lg:col-span-4 mb-12 md:mb-0">
        <div class="flex md:block items-baseline gap-4 mb-6 md:mb-0">
          <span
            class="font-mono text-text-meta block"
            style="font-size: 11px; letter-spacing: 0.16em;"
            data-reveal
          >03 / 06</span>
          <p
            class="eyebrow md:mt-3"
            style="--reveal-delay: 80ms;"
            data-reveal
          >What we treat</p>
        </div>

        <p
          class="md:mt-8 max-w-[28ch] text-ink-700"
          style="font-size: clamp(1rem, 0.4vw + 0.95rem, 1.1875rem); line-height: 1.55; --reveal-delay: 200ms;"
          data-reveal
        >
          Six core services from a single Marylebone clinic. One coordinated record. One team.
        </p>
      </aside>

      <!-- The index of services. -->
      <ol class="md:col-span-8 lg:col-span-8" role="list">
        {services.map((s, i) => (
          <li
            data-reveal
            style={`--reveal-delay: ${280 + i * 80}ms;`}
          >
            <a
              href={s.href}
              class="service-row group block py-7 md:py-9 border-t border-border-soft last:border-b last:border-b-border-soft hover:border-t-ink-900"
            >
              <div class="grid grid-cols-12 gap-3 md:gap-6 items-baseline">

                <!-- Number -->
                <span
                  class="col-span-2 md:col-span-1 font-mono text-text-meta tabular-nums pt-1 md:pt-3"
                  style="font-size: 12px; letter-spacing: 0.08em;"
                >{s.num}</span>

                <!-- Service name (large Fraunces, the visual anchor) -->
                <span
                  class="col-span-9 md:col-span-6 font-display text-text-strong tracking-[-0.02em] leading-[1.05] block transition-colors duration-300 group-hover:text-accent-600"
                  style="font-size: clamp(1.875rem, 2.4vw + 1rem, 3rem); font-weight: 360; font-variation-settings: 'opsz' 144, 'SOFT' 40;"
                >{s.name}</span>

                <!-- Blurb -->
                <span
                  class="hidden md:block md:col-span-4 text-text-muted self-center pl-2"
                  style="font-size: 14px; line-height: 1.5;"
                >{s.blurb}</span>

                <!-- Arrow -->
                <span class="col-span-1 md:col-span-1 justify-self-end self-center text-text-muted transition-all duration-300 group-hover:text-accent-600 group-hover:translate-x-1 group-hover:-translate-y-0.5">
                  <Icon name="arrow-up-right" size={20} />
                </span>

              </div>

              <!-- Mobile-only blurb (below row content, smaller). -->
              <p
                class="md:hidden mt-2 text-text-muted pl-[calc(8.333%+0.75rem)]"
                style="font-size: 13px; line-height: 1.5;"
              >{s.blurb}</p>

            </a>
          </li>
        ))}
      </ol>

    </div>

    <!-- Closing hairline. Removed because the last <li> already has a bottom
         border, so we'd double-up. Skipped intentionally. -->

  </Container>
</section>

<style>
  /* The accent rule on hover.
   *
   * We want a subtle "the top edge of the row turns ink-black on hover"
   * effect. Tailwind's hover:border-t-ink-900 colours the existing 1px
   * border-soft (cream) to ink-black, giving a soft underline-like feel
   * without adding new geometry. */
  .service-row {
    transition: border-color 300ms var(--ease-out-quint);
  }
</style>
